# ==============================================================================
# 7MZ Store Mini App — PRODUCTION environment (Vercel project variables)
# Set these in Vercel → Project → Settings → Environment Variables.
# ==============================================================================

# Your Railway API public URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://YOUR-API.up.railway.app

# SECURITY: must be false in production — disables the mock Telegram env
NEXT_PUBLIC_DEV_MODE=false

# Your bot's username (for share/invite links), without @
NEXT_PUBLIC_BOT_USERNAME=
