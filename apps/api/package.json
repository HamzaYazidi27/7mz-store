{
  "name": "@7mz/api",
  "version": "1.0.0",
  "private": true,
  "description": "7MZ Store REST API — NestJS + PostgreSQL (Prisma) + Redis",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@nestjs/common": "^11.0.13",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.13",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.13",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^7.9.0",
    "axios": "^1.8.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "nestjs-pino": "^4.4.0",
    "otplib": "^13.4.1",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^22.3.2",
    "zod": "^4.4.3",
    "@prisma/adapter-pg": "^7.9.0",
    "dotenv": "^17.4.2",
    "@7mz/shared": "workspace:*",
    "prisma": "^7.9.0",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@7mz/typescript-config": "workspace:*",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.8.2"
  }
}
