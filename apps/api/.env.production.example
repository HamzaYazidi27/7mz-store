# ==============================================================================
# 7MZ Store API — PRODUCTION environment (Railway service variables)
# Set these in Railway → your API service → Variables.
# ${{Postgres.DATABASE_URL}} / ${{Redis.REDIS_URL}} are Railway references that
# auto-wire the plugins you add to the project.
# ==============================================================================

NODE_ENV=production
# Railway injects PORT automatically — the API reads it.

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# Generate each with:  openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=

# From @BotFather (never share this token anywhere else)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SECURITY: must be false in production (the API also hard-disables it)
AUTH_DEV_BYPASS=false

# Your deployed frontend origin(s), comma-separated — no wildcard in production
CORS_ORIGINS=https://YOUR-MINIAPP.vercel.app
MINIAPP_URL=https://YOUR-MINIAPP.vercel.app
API_PUBLIC_URL=https://YOUR-API.up.railway.app

SWAGGER_ENABLED=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Storage (optional at launch — product images ship with the frontend build;
# fill these when you start uploading via the admin panel)
STORAGE_DRIVER=local
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# Payment providers (leave empty until you have live keys — gateways report
# themselves unavailable, no code changes needed to activate later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live
PAYPAL_WEBHOOK_ID=
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET=
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

REFERRAL_COMMISSION_PERCENT=5
